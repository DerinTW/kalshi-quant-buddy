# ── Kalshi API ────────────────────────────────────────────────────────────────
KALSHI_API_KEY=
KALSHI_PRIVATE_KEY_PATH=./kalshi_private.pem
KALSHI_BASE_URL=https://api.elections.kalshi.com/trade-api/v2

# ── Anthropic ─────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-7

# ── Perplexity (optional but strongly recommended for real-time research) ─────
# Without this, research agents use LLM training data only (potentially stale)
PERPLEXITY_API_KEY=
PERPLEXITY_MODEL=sonar

# ── Trading mode (PAPER_ONLY=true is the safe default) ───────────────────────
TRADING_MODE=paper
KILL_SWITCH=true
PAPER_ONLY=true
LIVE_TRADING_ENABLED=false
ALLOW_LIVE_ORDERS=false
LIVE_CONFIRMATION_PHRASE=
DRY_RUN_LOG_ONLY=true
PAPER_BANKROLL=1000.00
DEBUG=false

# ── Market filter thresholds ──────────────────────────────────────────────────
MIN_LIQUIDITY=500
MIN_LIQUIDITY_DOLLARS=500
MAX_SPREAD_PCT=20
MIN_MINUTES_TO_EXPIRY=20
MAX_TIME_TO_RESOLUTION_HOURS=72
MAX_MINUTES_TO_EXPIRY=4320
MIN_VOLUME=1000
MIN_VOLUME_24H=1000
MIN_YES_PRICE=15
MAX_YES_PRICE=85
MAX_SPREAD_CENTS=6
MAX_ORDERBOOK_AGE_SECONDS=60
MIN_ORDERBOOK_DEPTH_AT_LIMIT=100
# politics omitted by default — add it back manually if needed
CATEGORY_ALLOWLIST=crypto,financial,economic,commodities,weather,science and technology,culture
# Event/series families skipped before normalization/enrichment.
BLOCKED_EVENT_PREFIXES=KXATP,KXWTA,KXWNBA,KXNBA,KXNFL,KXNHL,KXMLB,KXUFC,KXPGA,KXNCAAF,KXNCAAB,KXMLS
# Comma-separated tickers to never trade, e.g. KXBTCD-24DEC31-B50000,TICKER2
BLOCKED_TICKERS=

# ── Anomaly detection ─────────────────────────────────────────────────────────
# weird_move.py currently uses module constants; these env vars document intended tuning knobs.
PRICE_JUMP_THRESHOLD_PCT=10
STALE_BOOK_MINUTES=60
PRICE_JUMP_5M_CENTS=8
PRICE_JUMP_15M_CENTS=12
VOLUME_SPIKE_RATIO=3.0
SPREAD_WIDEN_RATIO=2.0
RELATED_MARKET_DISAGREEMENT_CENTS=10

# ── Edge thresholds ───────────────────────────────────────────────────────────
MIN_EDGE_PCT=8
MIN_ADJUSTED_EDGE_PCT=5
SLIPPAGE_CENTS=2
FEE_PCT=0.0

# ── Risk limits ───────────────────────────────────────────────────────────────
MAX_TRADE_DOLLARS=10
MAX_TOTAL_EXPOSURE_DOLLARS=200
MAX_POSITION_PCT_OF_BANKROLL=5
MAX_CORRELATED_EXPOSURE_DOLLARS=75
MAX_DAILY_LOSS=20
MAX_TRADES_PER_DAY=5

# ── Live trading gates (ALL must be true for live execution) ──────────────────
MIN_PAPER_TRADES_BEFORE_LIVE=100
MIN_PAPER_PNL_BEFORE_LIVE=0.0

# ── Monitoring / exits ───────────────────────────────────────────────────────
STOP_LOSS_CENTS=12
TAKE_PROFIT_CENTS=8
EXIT_IF_EDGE_BELOW_CENTS=2
NO_NEW_ENTRIES_LAST_MINUTES=20
FORCE_REVIEW_LAST_MINUTES=30

# ── Storage ───────────────────────────────────────────────────────────────────
LOG_DIR=./logs
DB_PATH=./black_gibbie.db

MAX_DOLLARS_PER_TRADE=10
MAX_TRADE_DOLLARS=10
MAX_LIVE_TRADE_DOLLARS=1
MAX_LIVE_DOLLARS_PER_TRADE=1
MAX_TOTAL_EXPOSURE_DOLLARS=200
MAX_POSITION_PCT_OF_BANKROLL=5
MAX_CORRELATED_EXPOSURE_DOLLARS=75
