# ---------------------------------------------------------------------------
# API KEYS
# ---------------------------------------------------------------------------
KALSHI_API_KEY=
KALSHI_PRIVATE_KEY_PATH=
KALSHI_BASE_URL=https://trading-api.kalshi.com/trade-api/v2

ANTHROPIC_API_KEY=
PERPLEXITY_API_KEY=
FRED_API_KEY=
EIA_API_KEY=
BLS_API_KEY=
NOAA_TOKEN=
NWS_USER_AGENT=black-gibbie (contact: unset)

# ---------------------------------------------------------------------------
# LLM CONFIG
# ---------------------------------------------------------------------------
ANTHROPIC_MODEL=claude-sonnet-4-6
PERPLEXITY_MODEL=sonar

# ---------------------------------------------------------------------------
# TRADING MODE / SAFETY DEFAULTS
# ---------------------------------------------------------------------------
TRADING_MODE=paper
KILL_SWITCH=true
PAPER_ONLY=true
LIVE_TRADING_ENABLED=false
ALLOW_LIVE_ORDERS=false
LIVE_CONFIRMATION_PHRASE=
DRY_RUN_LOG_ONLY=true
PAPER_BANKROLL=1000.00

# ---------------------------------------------------------------------------
# MARKET FILTERS
# ---------------------------------------------------------------------------
CATEGORY_ALLOWLIST=crypto,economic,financial,weather
BLOCKED_TICKERS=
MIN_LIQUIDITY_DOLLARS=500
MIN_LIQUIDITY=500
MIN_VOLUME_24H=1000
MIN_ORDERBOOK_DEPTH_AT_LIMIT=100
MAX_SPREAD_CENTS=6
MAX_SPREAD_PCT=15
MIN_YES_PRICE=15
MAX_YES_PRICE=85
MIN_MINUTES_TO_EXPIRY=20
MAX_MINUTES_TO_EXPIRY=4320
MAX_ORDERBOOK_AGE_SECONDS=60

# Backward-compatible aliases supported by config.py:
# MIN_VOLUME maps to MIN_VOLUME_24H
# MIN_TIME_TO_RESOLUTION_MINUTES maps to MIN_MINUTES_TO_EXPIRY
# MAX_TIME_TO_RESOLUTION_HOURS maps to MAX_MINUTES_TO_EXPIRY after converting hours to minutes
# MIN_LIQUIDITY maps to MIN_LIQUIDITY_DOLLARS

# ---------------------------------------------------------------------------
# WEIRD MOVE DETECTION
# ---------------------------------------------------------------------------
# weird_move.py currently uses module constants matching these values.
PRICE_JUMP_5M_CENTS=8
PRICE_JUMP_15M_CENTS=12
VOLUME_SPIKE_RATIO=3.0
SPREAD_WIDEN_RATIO=2.0
RELATED_MARKET_DISAGREEMENT_CENTS=10

# Legacy anomaly knobs still read by Config for compatibility.
PRICE_JUMP_THRESHOLD_PCT=10
VOLUME_SPIKE_MULTIPLIER=3.0
STALE_BOOK_MINUTES=60

# ---------------------------------------------------------------------------
# EDGE / CONFIDENCE
# ---------------------------------------------------------------------------
MIN_EDGE_PCT=7
MIN_ADJUSTED_EDGE_PCT=5
MIN_CONFIDENCE=0.65
MIN_CONFIDENCE_ADJUSTED_EDGE_CENTS=4.0
MAX_SPREAD_CENTS_EDGE=6
SLIPPAGE_CENTS=2
FEE_PCT=0.0

# The current code uses percentage-point/cents naming above. Blueprint names
# like MIN_EDGE_CENTS or FEE_CENTS are intentionally not active env vars here.

# ---------------------------------------------------------------------------
# RISK LIMITS
# ---------------------------------------------------------------------------
MAX_TRADE_DOLLARS=10
MAX_DOLLARS_PER_TRADE=10
MAX_TOTAL_EXPOSURE_DOLLARS=200
MAX_POSITION_PCT_OF_BANKROLL=0.5
MAX_BANKROLL_PCT_PER_TRADE=0.5
MAX_DAILY_LOSS_DOLLARS=20
MAX_DAILY_LOSS=20
MAX_TRADES_PER_DAY=5
MAX_CATEGORY_EXPOSURE_DOLLARS=25
MAX_CATEGORY_EXPOSURE=25
MAX_CORRELATED_EXPOSURE_DOLLARS=15
MAX_CORRELATED_EXPOSURE=15
MAX_LIVE_TRADE_DOLLARS=1
MAX_LIVE_DOLLARS_PER_TRADE=1
MIN_PAPER_TRADING_DAYS_BEFORE_LIVE=7
MIN_PAPER_DAYS_BEFORE_LIVE=7
MIN_PAPER_TRADES_BEFORE_LIVE=100
MIN_PAPER_PNL_BEFORE_LIVE=0

# ---------------------------------------------------------------------------
# POSITION MONITORING
# ---------------------------------------------------------------------------
MONITOR_INTERVAL_SECONDS=300
STOP_LOSS_CENTS=12
TAKE_PROFIT_CENTS=8
EXIT_IF_EDGE_BELOW_CENTS=2
NO_NEW_ENTRIES_LAST_MINUTES=20
FORCE_REVIEW_LAST_MINUTES=30

# ---------------------------------------------------------------------------
# LOGGING / STORAGE
# ---------------------------------------------------------------------------
LOG_DIR=./logs
DB_PATH=./black_gibbie.db
DEBUG=false
